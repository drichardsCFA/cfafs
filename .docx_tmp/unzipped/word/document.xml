A;&#xA;AI-generated content may be incorrect."/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1128181049" name="Picture 1" descr="A screenshot of a computer&#xA;&#xA;AI-generated content may be incorrect."/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId15"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="1376680"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="741D5723" w14:textId="77777777" w:rsidR="00AD0498" w:rsidRDefault="00AD0498"/><w:p w14:paraId="4D53D3C9" w14:textId="77777777" w:rsidR="00070482" w:rsidRDefault="00AD0498"><w:r><w:br w:type="page"/></w:r><w:r w:rsidR="00070482"><w:lastRenderedPageBreak/><w:t>Field Finance:</w:t></w:r></w:p><w:p w14:paraId="38FA10A1" w14:textId="184C9744" w:rsidR="008B46D6" w:rsidRDefault="00070482"><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00070482"><w:t>CFA's cutting-edge loan origination platform,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00070482"><w:t xml:space="preserve"> has been a game-changer for agricultural retailers and producers. By streamlining the financing process and offering unparalleled flexibility, Field Finance empowers users to access tailored solutions that align with their operational needs. Request a demo today to learn more about our input financing products.</w:t></w:r></w:p><w:p w14:paraId="5FB05DEC" w14:textId="722777F8" w:rsidR="00070482" w:rsidRDefault="00070482"><w:r><w:t>Request a demo:</w:t></w:r></w:p><w:p w14:paraId="7A11B59D" w14:textId="65BAEEDA" w:rsidR="00070482" w:rsidRDefault="00070482"><w:r><w:t>Have our expert team give you a tour of our solutions. We have flexible options that can meet the needs of any agricultural portfolio. See how we can improve your input financing options.</w:t></w:r></w:p><w:p w14:paraId="20BE31C3" w14:textId="02828902" w:rsidR="00070482" w:rsidRDefault="00070482"><w:r><w:t>Features and Benefits</w:t></w:r></w:p><w:p w14:paraId="6D5BB773" w14:textId="3D54CDD5" w:rsidR="00070482" w:rsidRDefault="00070482"><w:r><w:t xml:space="preserve">Convenient - </w:t></w:r><w:r w:rsidRPr="00070482"><w:t>Easy to apply. Fast approval process. Simple loan documentation.</w:t></w:r></w:p><w:p w14:paraId="58E0FEDC" w14:textId="290A4927" w:rsidR="00070482" w:rsidRDefault="00070482"><w:r><w:t xml:space="preserve">Expert Support - </w:t></w:r><w:r w:rsidR="0076015E" w:rsidRPr="0076015E"><w:t>CFA provides ongoing marketing support and training to your staff.</w:t></w:r></w:p><w:p w14:paraId="46B2D345" w14:textId="1226EB0F" w:rsidR="0076015E" w:rsidRDefault="0076015E"><w:r><w:t xml:space="preserve">Comprehensive - </w:t></w:r><w:r w:rsidRPr="0076015E"><w:t>Finance all agricultural production needs under one loan with CFA.</w:t></w:r></w:p><w:p w14:paraId="53B62429" w14:textId="4045DA33" w:rsidR="0076015E" w:rsidRDefault="0076015E"><w:r><w:t xml:space="preserve">Cost-Effective - </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="0076015E"><w:t>All of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="0076015E"><w:t xml:space="preserve"> the advantages of a captive financing company without the cost of operation or capitalization.</w:t></w:r></w:p><w:p w14:paraId="4E7971F3" w14:textId="033055E6" w:rsidR="0076015E" w:rsidRDefault="0076015E"><w:r><w:t xml:space="preserve">Competitive Advantage - </w:t></w:r><w:r w:rsidRPr="0076015E"><w:t>Make your offering very desirable to the customer with easily customizable loan programs and interest subsidy matching.</w:t></w:r></w:p><w:p w14:paraId="72833502" w14:textId="0BC1C888" w:rsidR="0076015E" w:rsidRDefault="0076015E"><w:r><w:t xml:space="preserve">Flexible - </w:t></w:r><w:r w:rsidRPr="0076015E"><w:t xml:space="preserve">Competitive interest rate options and loan </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="0076015E"><w:t>maturities</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="0076015E"><w:t xml:space="preserve"> to match your marketing needs.</w:t></w:r></w:p><w:p w14:paraId="0B00DC10" w14:textId="1550BCF0" w:rsidR="00070482" w:rsidRDefault="0076015E"><w:r w:rsidRPr="0076015E"><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="4A5B2569" wp14:editId="23C8FE02"><wp:extent cx="5943600" cy="2289810"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="605142638" name="Picture 1" descr="A screenshot of a computer&#xA;&#xA;AI-generated content may be incorrect."/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="605142638" name="Picture 1" descr="A screenshot of a computer&#xA;&#xA;AI-generated content may be incorrect."/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId16"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5943600" cy="2289810"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r><w:r w:rsidRPr="0076015E"><w:rPr><w:noProof/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="0076015E"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="39517FA1" wp14:editId